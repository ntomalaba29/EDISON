{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "edison",
  "main": "./src/cloudflare/worker.ts",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "EDISON_DB",
      "database_name": "edison-staging",
      "database_id": "c71f8fa3-823d-4f7b-98fc-be198d4d1bd3",
      "migrations_dir": "migrations/cloudflare-d1"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  }
}
